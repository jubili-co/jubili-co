# PostHog project API key from Project settings (starts with phc_).
# Analytics stays off until this is set. Add the same value in Vercel env vars.
PUBLIC_POSTHOG_PROJECT_TOKEN=

# Ingestion host. Default is EU Cloud, which matches this Vienna site.
# US Cloud: https://us.i.posthog.com — also update vercel.json destinations.
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
