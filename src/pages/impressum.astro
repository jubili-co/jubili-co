---
import Layout from "../layouts/Layout.astro";
export const prerender = true;
---
<Layout title="Legal Notice | Jubili" description="Legal notice for Jubili">
  <main class="mx-auto min-h-screen max-w-3xl px-6 py-20 text-ploy-text-primary">
    <a href="/" class="text-sm underline">← Back</a>
    <h1 class="mt-12 font-heading text-5xl">Legal Notice</h1>
    <div class="mt-10 space-y-6 text-ploy-text-secondary">
      <p><strong class="text-ploy-text-primary">Placeholder: complete before publishing.</strong></p>
      <p>[Full legal company name]<br />[Street and number]<br />[Postcode] Vienna<br />Austria</p>
      <p>Email: office@jubili.co<br />Telephone: [telephone number]<br />Company registration number: [number]<br />Registration court: [court]<br />VAT number: [VAT number]</p>
      <p>Business activity: interior architecture, furnishing concepts and related services.</p>
    </div>
  </main>
</Layout>
