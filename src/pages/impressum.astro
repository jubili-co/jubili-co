---
import Layout from "../layouts/Layout.astro";
export const prerender = true;
---
<Layout title="Impressum | Jubili" description="Impressum von Petrina Manase Salema e.U.">
  <main class="mx-auto min-h-screen max-w-3xl px-6 py-20 text-ploy-text-primary">
    <a href="/" class="text-sm underline">← Zurück</a>
    <h1 class="mt-12 font-heading text-5xl">Impressum</h1>
    <div class="mt-10 space-y-6 text-ploy-text-secondary">
      <p><strong class="text-ploy-text-primary">Platzhalter — vor Veröffentlichung vervollständigen.</strong></p>
      <p>Petrina Manase Salema e.U.<br />[Straße und Hausnummer]<br />[PLZ] Wien<br />Österreich</p>
      <p>E-Mail: office@jubili.co<br />Telefon: [Telefonnummer]<br />Firmenbuchnummer: [Nummer]<br />Firmenbuchgericht: [Gericht]<br />UID-Nummer: [UID]</p>
      <p>Unternehmensgegenstand: Innenarchitektur, Einrichtungskonzeption und damit verbundene Dienstleistungen.</p>
    </div>
  </main>
</Layout>
